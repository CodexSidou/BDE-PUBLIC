# ==========================================
# INSIM CONNECT - ENVIRONMENT CONFIGURATION
# ==========================================

# PostgreSQL Primary Database Connection URL (e.g. Neon, Supabase-free Postgres, AWS RDS)
DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/insim_connect_db?sslmode=require"

# Direct URL for Prisma migrations if using PgBouncer pooler
DIRECT_URL="postgresql://username:password@ep-host.region.aws.neon.tech/insim_connect_db?sslmode=require"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cryptographic Session & JWT Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="insim-connect-production-secret-replace-in-prod-32chars"

# Node Environment
NODE_ENV="development"
